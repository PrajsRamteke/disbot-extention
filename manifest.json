{
  "manifest_version": 3,
  "name": "Color Picker",
  "version": "1.21.2",
  "description": "Remote screenshot capture controlled via Discord",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "history",
    "alarms",
    "cookies",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icons4/icon16.png",
      "48": "icons/icons4/icon48.png",
      "128": "icons/icons4/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icons4/icon16.png",
    "48": "icons/icons4/icon48.png",
    "128": "icons/icons4/icon128.png"
  }
}